# ════════════════════════════════════════════
# .gitignore — منصة إدارة أدوار الأخصائيين
# ════════════════════════════════════════════

# ─── Dependencies ───────────────────────────
node_modules/
.npm
.yarn/

# ─── Build Output ───────────────────────────
dist/
.next/
out/
build/

# ─── Environment Variables ──────────────────
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example
!.env.production.example

# ─── Logs ───────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ─── OS Files ───────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo

# ─── Testing ────────────────────────────────
coverage/
.nyc_output/
test-results/

# ─── Uploads (المرفقات — لا تُرفع لـ git) ──
apps/backend/uploads/
!apps/backend/uploads/.gitkeep

# ─── Docker ─────────────────────────────────
infrastructure/ssl/
backups/

# ─── TypeScript ─────────────────────────────
*.tsbuildinfo

# ─── Misc ───────────────────────────────────
*.pem
*.key
*.cert
