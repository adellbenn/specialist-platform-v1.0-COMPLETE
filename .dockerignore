# ════════════════════════════════════════════
# .dockerignore — جذر الـ monorepo
# يُستخدم كـ build context لجميع الصور (backend/frontend)
# ════════════════════════════════════════════

# Git
.git
.gitignore

# Dependencies (يُثبَّت داخل الصورة)
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
.next/
**/.next/
out/
build/
coverage/

# Environment — لا تُنسخ أبداً داخل الصورة
.env
.env.*
!.env.example
!.env.production.example

# Runtime data
apps/backend/uploads/
apps/backend/data/
backups/
infrastructure/ssl/

# Logs & temp
logs/
*.log
*.tsbuildinfo

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
