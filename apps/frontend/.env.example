# ════════════════════════════════════════════════════════════
# منصة إدارة أدوار الأخصائيين — Frontend Environment
# انسخ هذا الملف إلى .env.local وعدّل القيم
# ════════════════════════════════════════════════════════════

# رابط الـ API — يُثبَّت وقت البناء (build time) ولا يمكن تغييره
# بعد البناء. القيمة الافتراضية إذا لم تُضبط: '/api/v1' (نفس الأصل
# عبر nginx/Next rewrite). اتركها فارغة في الإنتاج إن كان nginx
# يوجّه /api/v1 إلى الـ backend.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── LAN (للوصول من الشبكة المحلية) ─────────────────────
# غيّر localhost بـ IP جهازك
# مثال: NEXT_PUBLIC_API_URL=http://192.168.1.100:3001/api/v1
