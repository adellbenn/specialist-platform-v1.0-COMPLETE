# ════════════════════════════════════════════════════════════
# منصة إدارة أدوار الأخصائيين — Backend Environment
# انسخ هذا الملف إلى .env وعدّل القيم
# ════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_NAME=specialist-platform
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=strongpassword123
DB_NAME=specialist_platform
# MUST be false in Production — use migrations instead
DB_SYNC=true
DB_LOGGING=false
# Pool settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
# SSL certificate verification (PostgreSQL only)
# Set to "false" ONLY if using self-signed certs in dev/staging
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT ──────────────────────────────────────────────────
# غيّر هذه القيم في الإنتاج — يجب أن تكون 64+ حرف عشوائي
JWT_SECRET=dev-jwt-secret-change-in-production-min-64-characters-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-64-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (للتخزين المؤقت و Throttling) ──────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Storage ──────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE=10485760

# ─── Rate Limiting ────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── AWS S3 (اختياري — للتخزين السحابي) ─────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=me-south-1
# AWS_S3_BUCKET=specialist-platform

# ─── LAN (للوصول من الشبكة المحلية) ─────────────────────
# غيّر FRONTEND_URL بـ IP جهازك على الشبكة
# مثال: FRONTEND_URL=http://192.168.1.100:3000

# ─── OpenTelemetry (Distributed Tracing) ─────────────────
OTEL_SERVICE_NAME=specialist-platform-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# otlp | console | none
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
