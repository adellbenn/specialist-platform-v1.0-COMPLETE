# ════════════════════════════════════════════════════════════
# .env.production — بيئة الإنتاج
# انسخ هذا الملف إلى .env.production وعدّل القيم
# ════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────
NODE_ENV=production
APP_PORT=3001
APP_NAME="منصة إدارة أدوار الأخصائيين"
DOMAIN=your-domain.com
FRONTEND_URL=https://your-domain.com

# نطاقات CORS المسموح بها (مفصولة بفاصلة)
CORS_ORIGINS=https://your-domain.com

# ─── Database ────────────────────────────────────────────
# إلزامي في الإنتاج — القيمة الافتراضية في الكود هي sqlite
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=specialist_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_32CHARS
DB_NAME=specialist_platform
DB_SYNC=false
DB_LOGGING=false
# DB_SSL تفعيل TLS لقاعدة البيانات (الافتراضي true في الإنتاج).
# اتركه true مع قواعد مُدارة (RDS/Cloud SQL)، واضبطه false إذا كانت
# القاعدة داخل شبكة موثوقة بدون TLS (مثل postgres في docker-compose).
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED: تجاهل التحقق من الشهادة عند الحاجة
# (لا ينصح به — استخدم فقط للاتصالات الداخلية الموثوقة).
# DB_SSL_REJECT_UNAUTHORIZED=false

# ─── Super Admin (تُنشأ عند أول تشغيل إن لم تكن موجودة) ──
# إلزامية: بدون SUPER_ADMIN_PASSWORD يرفض التطبيق الإقلاع في الإنتاج
# ⚠ هذا الحساب هو "الحساب الرئيسي المُحمى" (Primary Super Admin) —
#   الخادم يرفض تعديله/حذفه (Protection in users.service)، فلا تستخدمه
#   لعمليات الأنظمة اليومية، ولا تُغيّره بعد إنشائه إلا بتغيير متعمّد للبريد في البيئة.
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=CHANGE_THIS_SUPER_ADMIN_PASSWORD_MIN_64_CHARS

# ─── JWT (يجب أن تكون قيم عشوائية قوية 64+ حرف) ─────────
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_64_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_MIN_64_CHARACTERS_DIFFERENT
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ─── ClamAV (فحص الفيروسات — الخدمة في docker-compose) ──
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ─── Storage ─────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/uploads
MAX_FILE_SIZE=10485760

# AWS S3 (إذا أردت التخزين السحابي)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=me-south-1
# AWS_S3_BUCKET=

# ─── Rate Limiting ───────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
