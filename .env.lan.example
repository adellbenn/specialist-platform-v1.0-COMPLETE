# ════════════════════════════════════════════════════════════
# إعداد LAN — الوصول من أجهزة الشبكة المحلية
# ════════════════════════════════════════════════════════════

# للوصول من أجهزة أخرى على نفس الشبكة:
# 1. تشغيل الـ Backend على 0.0.0.0 (موجود بالفعل في main.ts)
# 2. تشغيل الـ Frontend على 0.0.0.0

# اعرف IP الجهاز الرئيسي بـ:
#   ipconfig (Windows) → IPv4 Address
#   مثال: 192.168.1.100

# الأجهزة الأخرى تفتح:
#   http://192.168.1.100:3000  ← Frontend
#   http://192.168.1.100:3001  ← Backend API

# ─── للـ Frontend (apps/frontend/.env.local) ─────────────
NEXT_PUBLIC_API_URL=http://192.168.1.100:3001/api/v1
NEXT_PUBLIC_APP_NAME=منصة إدارة أدوار الأخصائيين

# ─── للـ Backend (apps/backend/.env) ─────────────────────
NODE_ENV=development
APP_PORT=3001
FRONTEND_URL=http://192.168.1.100:3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=strongpassword123
DB_NAME=specialist_platform
DB_SYNC=true
DB_LOGGING=false
JWT_SECRET=your-secret-key-change-in-production-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-64-chars
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE=10485760
THROTTLE_TTL=60
THROTTLE_LIMIT=100
